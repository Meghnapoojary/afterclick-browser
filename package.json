{
  "name": "afterclick-desktop",
  "version": "0.6.1",
  "private": true,
  "description": "AFTERCLICK \u2014 a desktop browser MVP for browsing, guided tasks and evidence-backed outcome verification.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "check": "tsc --noEmit --pretty false",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "electron-builder": "26.18.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "build": {
    "appId": "com.afterclick.desktop",
    "productName": "AFTERCLICK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "artifactName": "AFTERCLICK-Setup-${version}-${arch}.${ext}",
    "win": {
      "icon": "electron/assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AFTERCLICK",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AFTERCLICK-Setup-${version}-${arch}.${ext}"
    }
  }
}
